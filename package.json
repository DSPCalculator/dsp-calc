    "pinyin-pro": "^3.28.1",
    "react": "^19.2.5",
    "react-bootstrap": "^2.10.10",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.2.5",
    "react-github-corner": "^2.5.0",
    "react-icons": "^5.6.0",
    "terser": "^5.46.2"
